# --- Discord ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_TOKEN=
# Your own Discord user ID. Loopdog ignores everyone else, silently.
# Enable Developer Mode in Discord, then right-click your name -> Copy User ID.
DISCORD_OWNER_ID=

# --- Anthropic -------------------------------------------------------------
# From https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=

# --- Behaviour -------------------------------------------------------------
# IANA timezone. Drives "today", "tomorrow at 9am", and streak day boundaries.
LOOPDOG_TZ=Europe/Stockholm

# The hour your day rolls over. 4 means a habit logged at 01:30 counts for
# yesterday. Set to 0 for strict calendar days.
LOOPDOG_DAY_CUTOFF_HOUR=4

# What Loopdog calls you. The name is used for anything with weight; the
# nickname for lighter moments. Both are used sparingly.
LOOPDOG_USER_NAME=Sam
LOOPDOG_USER_NICKNAME=Sobi

# Where the SQLite file lives.
LOOPDOG_DB=./loopdog.sqlite

# Reasoning effort: low | medium | high | xhigh | max
# low keeps replies snappy. Raise it if tool choices start looking careless.
LOOPDOG_EFFORT=low

# How often, in minutes, Loopdog checks for reminders that just fell due and
# DMs you proactively. Each reminder is pushed once; it keeps showing up in
# conversation until you complete or delete it, regardless of this.
LOOPDOG_PUSH_INTERVAL_MINUTES=5

# The hour (0-23, local time) Loopdog checks for habits with a live streak
# and nothing logged yet today, and sends one DM about it if there's anything
# to say. Fires at most once per day.
LOOPDOG_AT_RISK_NUDGE_HOUR=21

# The hour (0-23, local time) the Sunday evening digest goes out. Fires at
# most once per week.
LOOPDOG_DIGEST_HOUR=20

# The hour (0-23, local time) the morning brief goes out — what's due today
# and what's at risk, in one message. Only sends if there's something to
# say. Fires at most once per day.
LOOPDOG_MORNING_BRIEF_HOUR=8

# Reminders that fall due inside this local-time window are held until it
# ends instead of pushing immediately — so a 3am reminder doesn't wake you
# at 3am. Wraps past midnight (23 -> 7 means 11pm-7am). Set both to the same
# value to disable.
LOOPDOG_QUIET_HOURS_START=23
LOOPDOG_QUIET_HOURS_END=7

# City used for weather lookups when the user doesn't name one.
LOOPDOG_CITY=Stockholm

# How often, in minutes, each watched page gets re-checked for changes.
# Independent of LOOPDOG_PUSH_INTERVAL_MINUTES — deliberately slower by
# default, since these requests go to someone else's server.
LOOPDOG_WATCH_INTERVAL_MINUTES=60

# --- Google Calendar (optional) ----------------------------------------------
# Entirely optional. Leave both unset and Calendar tools just report
# "not set up yet" instead of failing to boot. Calendar only, not Gmail —
# Google's OAuth device flow doesn't support Gmail scopes at all (a real
# platform limitation, not a config gap), so Gmail has its own separate
# client below. This one is a "TVs and Limited Input devices" OAuth client;
# see the README's Google Calendar section for how to create it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail (optional) --------------------------------------------------------
# A SEPARATE OAuth client from GOOGLE_CLIENT_ID above, and necessarily so:
# that one is a device-flow client, which Google refuses to issue Gmail
# scopes to. This one must be of type "Desktop app", which can do the
# loopback-redirect flow Gmail needs.
#
# GMAIL_REFRESH_TOKEN comes from running `npm run gmail-login` once at a
# terminal (it opens a browser, catches the redirect on 127.0.0.1, and
# prints the token) — not from a Discord flow, same as TELEGRAM_SESSION.
#
# Publish your OAuth consent screen before doing this. While it's in
# "Testing", Google expires refresh tokens after 7 days — this login, and
# your Calendar connection, would both die weekly. See the README's Gmail
# section.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Hotmail / Outlook (optional) --------------------------------------------
# A separate account from Google above — both can be connected at once.
# Entirely optional. Leave unset and Hotmail email tools just report "not set
# up yet" instead of failing to boot. No client secret: the device flow's
# public-client token exchange never sends one. See the README's Hotmail /
# Outlook section for how to get this from the Azure Portal.
HOTMAIL_CLIENT_ID=

# --- PrivateMail (optional) --------------------------------------------------
# A custom-domain mailbox hosted on Namecheap Private Email
# (mail.privateemail.com) — a third, independent account from the two above.
# No OAuth exists for this product: these are the mailbox's actual
# username (its email address) and password, used directly over IMAP.
# Entirely optional. Leave unset and PrivateMail email tools just report
# "not set up yet" instead of failing to boot.
PRIVATEMAIL_EMAIL=
PRIVATEMAIL_PASSWORD=

# --- Telegram (optional, read only) ------------------------------------------
# Reads your own account's chats — not a bot's inbox. No connect step exists
# from inside Discord: run `npm run telegram-login` locally once (needs your
# phone to receive a real login code), then paste the session string it
# prints as TELEGRAM_SESSION below. TELEGRAM_API_ID/TELEGRAM_API_HASH come
# from https://my.telegram.org/apps (a one-time developer registration, not
# a per-login thing). Entirely optional — leave all three unset and Telegram
# tools just report "not set up yet."
#
# TELEGRAM_SESSION is NOT a scoped credential the way an OAuth token is —
# it grants full account access. Guard it like the account password itself.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- Web search (optional) ---------------------------------------------------
# Real live web search (not just "fetch a URL you already have"), via Tavily
# (tavily.com) — free tier, no credit card. Entirely optional — leave unset
# and web_search just reports "not set up yet" instead of failing to boot.
TAVILY_API_KEY=

# --- Trafiklab trip planning (optional) --------------------------------------
# Cross-operator journey planning (SL + SJ + regional) via Trafiklab's
# ResRobot API — separate from get_transit_departures, which needs no key at
# all. Free signup at https://www.trafiklab.se. Leave unset and
# plan_transit_trip just reports "not set up yet."
TRAFIKLAB_API_KEY=

# --- Electricity spot prices (optional, works out of the box) ---------------
# Swedish day-ahead electricity pricing via elprisetjustnu.se — free, no key,
# official Nord Pool data. get_electricity_price works with zero setup;
# these two only matter if you want to change the defaults.
LOOPDOG_ELECTRICITY_ZONE=SE3
# Off by default. Set to true for a proactive DM when the price hits today's
# cheapest quarter — a more opinionated nudge than the on-demand tool, so it
# doesn't turn on just because the tool works.
LOOPDOG_ELECTRICITY_NUDGE=false

# --- SMHI weather warnings (optional) ----------------------------------------
# Severe-weather warnings from Sweden's met office — free, no key.
# get_weather_warnings works unfiltered (all active, nationwide) with this
# unset. Set to a Swedish county/län to filter the on-demand tool AND enable
# the proactive DM-on-new-warning check (off otherwise — no sensible default
# region to watch). Runs even during a vacation mute; this is a safety
# matter, not an unprompted nudge.
LOOPDOG_SMHI_COUNTY=

# --- Canvas LMS (optional) ---------------------------------------------------
# Read-only access to your Canvas courses, upcoming assignments, and
# announcements. CANVAS_BASE_URL is your institution's Canvas instance, e.g.
# https://kth.instructure.com (Canvas is hosted per-institution, so there's no
# single default). CANVAS_API_TOKEN comes from Canvas itself: Account >
# Settings > + New Access Token — not OAuth, just a token you generate
# yourself and paste here. Entirely optional — leave both unset and the
# Canvas tools just report "not set up yet" instead of failing to boot.
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# --- Tuya smart plugs (optional) ---------------------------------------------
# Controls DELTACO smart plugs, which are rebranded Tuya hardware — no
# DELTACO-specific setup, this goes through Tuya's own Cloud API. Needs a
# Cloud Project on Tuya's IoT developer platform (iot.tuya.com), with the
# Smart Life/DELTACO Smart app account linked to it (a QR-code flow in the
# platform's own UI) — TUYA_ACCESS_ID/TUYA_ACCESS_SECRET come from the
# project, TUYA_UID is the linked account's id, shown once linking is done.
# TUYA_API_ENDPOINT defaults to the EU data center, right for a
# Nordic-registered account — only change it if Tuya's console says
# otherwise. Entirely optional — leave any of the three required ones unset
# and the smart-device tools just report "not set up yet."
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_UID=
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# --- Roborock vacuum (optional) ----------------------------------------------
# Controls a Roborock vacuum over Roborock's cloud MQTT relay (Loopdog runs on
# Railway, not your home LAN, so the faster local-network protocol Home
# Assistant uses isn't reachable from here). No in-conversation connect step —
# run `npm run roborock-login` once locally (needs an email verification code,
# same as logging into the Roborock app for the first time), then paste the
# JSON it prints as ROBOROCK_USER_DATA below. Entirely optional — leave unset
# and the vacuum tools just report "not set up yet." Treat the value like a
# password — it's an opaque session, not a scope-limited token.
ROBOROCK_USER_DATA=
