# --- Discord ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_TOKEN=
# Your own Discord user ID. Loopdog ignores everyone else, silently.
# Enable Developer Mode in Discord, then right-click your name -> Copy User ID.
DISCORD_OWNER_ID=

# --- Anthropic -------------------------------------------------------------
# From https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=

# --- Behaviour -------------------------------------------------------------
# IANA timezone. Drives "today", "tomorrow at 9am", and streak day boundaries.
LOOPDOG_TZ=Europe/Stockholm

# The hour your day rolls over. 4 means a habit logged at 01:30 counts for
# yesterday. Set to 0 for strict calendar days.
LOOPDOG_DAY_CUTOFF_HOUR=4

# What Loopdog calls you. The name is used for anything with weight; the
# nickname for lighter moments. Both are used sparingly.
LOOPDOG_USER_NAME=Sam
LOOPDOG_USER_NICKNAME=Sobi

# Where the SQLite file lives.
LOOPDOG_DB=./loopdog.sqlite

# Reasoning effort: low | medium | high | xhigh | max
# low keeps replies snappy. Raise it if tool choices start looking careless.
LOOPDOG_EFFORT=low

# How often, in minutes, Loopdog checks for reminders that just fell due and
# DMs you proactively. Each reminder is pushed once; it keeps showing up in
# conversation until you complete or delete it, regardless of this.
LOOPDOG_PUSH_INTERVAL_MINUTES=5

# The hour (0-23, local time) Loopdog checks for habits with a live streak
# and nothing logged yet today, and sends one DM about it if there's anything
# to say. Fires at most once per day.
LOOPDOG_AT_RISK_NUDGE_HOUR=21

# The hour (0-23, local time) the Sunday evening digest goes out. Fires at
# most once per week.
LOOPDOG_DIGEST_HOUR=20

# The hour (0-23, local time) the morning brief goes out — what's due today
# and what's at risk, in one message. Only sends if there's something to
# say. Fires at most once per day.
LOOPDOG_MORNING_BRIEF_HOUR=8

# Reminders that fall due inside this local-time window are held until it
# ends instead of pushing immediately — so a 3am reminder doesn't wake you
# at 3am. Wraps past midnight (23 -> 7 means 11pm-7am). Set both to the same
# value to disable.
LOOPDOG_QUIET_HOURS_START=23
LOOPDOG_QUIET_HOURS_END=7
