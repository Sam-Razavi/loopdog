{
  "name": "loopdog",
  "version": "0.1.0",
  "private": true,
  "description": "A personal daily-life agent that lives in Discord",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "chat": "tsx src/repl.ts",
